# Development environment variables for qontinui-runner
# Copy this file to .env and fill in your values
#
# SECURITY NOTE: The .env file contains real credentials and is gitignored.
# Never commit .env to version control. Only .env.example is committed.

# Auto-login credentials for development mode
# These are used to automatically log in during development
# Leave empty to disable auto-login
VITE_DEV_EMAIL=your-dev-email@example.com
VITE_DEV_PASSWORD=your-dev-password
