{
  "version": "2.0.0",
  "metadata": {
    "name": "Test Sequential Prompts",
    "description": "Tests that sequential AI prompts execute autonomously without user feedback",
    "author": "Qontinui"
  },
  "images": [],
  "workflows": [
    {
      "id": "test-hello-hi-sequence",
      "name": "Test Hello-Hi Sequence",
      "description": "First prompt says Hello, second prompt says Hi - both should run autonomously",
      "actions": [
        {
          "id": "prompt-hello",
          "type": "AI_PROMPT",
          "name": "Say Hello",
          "config": {
            "prompt": "Say exactly 'Hello' and nothing else. Just output the word Hello.",
            "freshContext": true,
            "timeout": 30000
          }
        },
        {
          "id": "prompt-hi",
          "type": "AI_PROMPT",
          "name": "Say Hi",
          "config": {
            "prompt": "Say exactly 'Hi' and nothing else. Just output the word Hi.",
            "freshContext": true,
            "timeout": 30000
          }
        }
      ],
      "category": "Main"
    },
    {
      "id": "test-prompt-sequence",
      "name": "Test Prompt Sequence",
      "description": "Uses RUN_PROMPT_SEQUENCE to execute multiple prompts in sequence",
      "actions": [
        {
          "id": "run-hello-hi-sequence",
          "type": "RUN_PROMPT_SEQUENCE",
          "name": "Run Hello-Hi Prompt Sequence",
          "config": {
            "inlineSequence": {
              "id": "hello-hi-sequence",
              "name": "Hello Hi Sequence",
              "steps": [
                {
                  "id": "step-hello",
                  "inlinePrompt": "Say exactly 'Hello' and nothing else. Just output the word Hello.",
                  "timeout": 30000
                },
                {
                  "id": "step-hi",
                  "inlinePrompt": "Say exactly 'Hi' and nothing else. Just output the word Hi.",
                  "timeout": 30000
                }
              ],
              "onFailure": "stop"
            }
          }
        }
      ],
      "category": "Main"
    }
  ],
  "states": [
    {
      "id": "state-ready",
      "name": "Ready",
      "isInitial": true,
      "identifyingImages": []
    }
  ],
  "transitions": [],
  "categories": [],
  "settings": {
    "execution": {
      "defaultTimeout": 60000,
      "executionMode": "real",
      "screenshotDirectory": ".dev-logs/screenshots",
      "useGraphExecution": false
    },
    "recognition": {
      "defaultThreshold": 0.9
    },
    "logging": {
      "level": "debug"
    }
  }
}
