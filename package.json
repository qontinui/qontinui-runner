{
  "name": "qontinui-runner",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "generate-spec-registry": "npx tsx ../qontinui-web/frontend/scripts/generate-spec-registry.ts",
    "predev": "npx tsx ../qontinui-web/frontend/scripts/generate-spec-registry.ts",
    "dev": "vite",
    "prebuild": "npx tsx ../qontinui-web/frontend/scripts/generate-spec-registry.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "npx tauri",
    "lint": "eslint src/**/*.{ts,tsx} --report-unused-disable-directives",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:lint": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:check": "cd src-tauri && cargo check",
    "check:all": "npm run check && npm run rust:check && npm run rust:lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-links": "^8.5.3",
    "@storybook/blocks": "^8.5.3",
    "@storybook/react": "^8.5.3",
    "@storybook/react-vite": "^8.5.3",
    "@tauri-apps/cli": "^2.9.4",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^4.0.17",
    "cross-env": "^7.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "storybook": "^8.5.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@qontinui/design-tokens": "^1.0.0",
    "@qontinui/shared-types": "github:qontinui/qontinui-schemas",
    "@qontinui/ui-bridge": "^0.3.1",
    "@qontinui/workflow-ui": "github:qontinui/qontinui-workflow-ui",
    "@qontinui/workflow-utils": "github:qontinui/qontinui-workflow-utils",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.16",
    "@tauri-apps/api": "^2.9",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5",
    "prism-react-renderer": "^2.4.1",
    "qontinui-navigation": "file:../qontinui-navigation",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ui-bridge": "^0.3.1",
    "vite": "^7.1.5"
  }
}
