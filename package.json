    "storybook": "^10.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  },
  "name": "qontinui-runner",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "build-storybook": "storybook build",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:all": "npm run check && npm run rust:check && npm run rust:lint",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "eslint src/**/*.{ts,tsx} --report-unused-disable-directives",
    "preview": "vite preview",
    "rust:check": "cd src-tauri && cargo check",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:lint": "cd src-tauri && cargo clippy -- -D warnings",
    "storybook": "storybook dev -p 6006",
    "tauri": "npx tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "graphql:codegen": "graphql-codegen",
    "graphql:check": "graphql-codegen && git diff --exit-code src/generated/graphql.ts || (echo 'GraphQL codegen output is stale — run npm run graphql:codegen' && exit 1)",
    "graphql:schema": "cd src-tauri && cargo test --bin qontinui-runner schema_exports_valid_sdl -- --nocapture",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0-beta.1"
}
