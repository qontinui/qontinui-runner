#!/usr/bin/env bash
# Direct commit-msg hook (replaces broken pre_commit Python module)
# Validates commit message format

set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check for conventional commit format
if ! echo "$COMMIT_MSG" | head -1 | grep -qE '^(feat|fix|refactor|style|docs|test|chore|perf|ci|build|revert)(\(.+\))?: .+'; then
    echo "ERROR: Commit message must follow conventional commit format:"
    echo "  <type>: <description>"
    echo "  Types: feat, fix, refactor, style, docs, test, chore, perf, ci, build, revert"
    echo ""
    echo "Your message: $(head -1 "$COMMIT_MSG_FILE")"
    exit 1
fi

echo "Commit message format OK."
