  "metadata": {
    "component": "ActiveDashboardPage",
    "tags": [
      "active-dashboard",
      "monitoring",
      "real-time",
      "tier-1"
    ]
  },
  "stateMachine": {
    "states": [
      {
        "description": "No workflow is running. The page shows a centered prompt with the 'No Active Workflow' heading and options to run the last workflow or view the last run recap.",
        "elements": [
          {
            "textContent": "No Active Workflow"
          }
        ],
        "id": "idle",
        "isInitial": true,
        "name": "Idle - No Active Workflow",
        "transitions": [
          {
            "activateStates": [
              "running"
            ],
            "deactivateStates": [
              "idle"
            ],
            "id": "idle-to-running",
            "name": "Start a workflow",
            "process": [
              {
                "action": "click",
                "target": {
                  "textContent": "Run Last Workflow"
                },
                "waitAfter": {
                  "timeout": 5000,
                  "type": "idle"
                }
              }
            ],
            "staysVisible": false
          }
        ]
      },
      {
        "description": "A workflow is actively executing. The control bar shows the task name, phase badges, and a Stop button; the dynamic widget layout displays the active widget at 65% and summary widgets at 35%.",
        "elements": [
          {
            "role": "button",
            "textContent": "Stop"
          }
        ],
        "id": "running",
        "isInitial": false,
        "name": "Running - Workflow Executing",
        "transitions": [
          {
            "activateStates": [
              "paused"
            ],
            "deactivateStates": [
              "running"
            ],
            "id": "running-to-paused",
            "name": "Pause the workflow",
            "process": [
              {
                "action": "click",
                "target": {
                  "accessibleName": "Pause",
                  "role": "button"
                },
                "waitAfter": {
                  "timeout": 2000,
                  "type": "idle"
                }
              }
            ],
            "staysVisible": false
          },
          {
            "activateStates": [
              "completion-overlay"
            ],
            "deactivateStates": [
              "running"
            ],
            "id": "running-to-completion-overlay",
            "name": "Workflow finishes (automatic transition)",
            "process": [],
            "staysVisible": false
          },
          {
            "activateStates": [
              "idle"
            ],
            "deactivateStates": [
              "running"
            ],
            "id": "running-to-idle",
            "name": "Stop the workflow",
            "process": [
              {
                "action": "click",
                "target": {
                  "role": "button",
                  "textContent": "Stop"
                },
                "waitAfter": {
                  "timeout": 3000,
                  "type": "idle"
                }
              }
            ],
            "staysVisible": false
          }
        ]
      },
      {
        "description": "The workflow is temporarily paused. The control bar shows a Play button to resume; widgets remain visible but execution is halted.",
        "elements": [
          {
            "accessibleName": "Play",
            "role": "button"
          }
        ],
        "id": "paused",
        "isInitial": false,
        "name": "Paused - Workflow Paused",
        "transitions": [
          {
            "activateStates": [
              "running"
            ],
            "deactivateStates": [
              "paused"
            ],
            "id": "paused-to-running",
            "name": "Resume the workflow",
            "process": [
              {
                "action": "click",
                "target": {
                  "accessibleName": "Play",
                  "role": "button"
                },
                "waitAfter": {
                  "timeout": 2000,
                  "type": "idle"
                }
              }
            ],
            "staysVisible": false
          }
        ]
      },
      {
        "description": "An overlay dialog appears when a workflow finishes. Shows the final status, step statistics, success rate, and duration. Auto-dismisses after 15 seconds.",
        "elements": [
          {
            "accessibleName": "Workflow completion summary",
            "role": "dialog"
          },
          {
            "textContent": "Dismiss"
          }
        ],
        "id": "completion-overlay",
        "isInitial": false,
        "name": "Completion Summary Overlay",
        "transitions": [
          {
            "activateStates": [
              "idle"
            ],
            "deactivateStates": [
              "completion-overlay"
            ],
            "id": "completion-overlay-to-idle",
            "name": "Dismiss the completion overlay",
            "process": [
              {
                "action": "click",
                "target": {
                  "textContent": "Dismiss"
                },
                "waitAfter": {
                  "timeout": 1000,
                  "type": "idle"
                }
              }
            ],
            "staysVisible": false
          }
        ]
      }
    ]
  },
  "version": "1.0.0"
}
