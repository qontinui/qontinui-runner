{
  "methods": [
    {
      "task_name": "open_workflow",
      "name": "open_workflow_by_name",
      "preconditions": {"active_states_include": ["tab-gui-automation"]},
      "actions": [
        ["click_element", "workflow-{target_state}"],
        ["wait_for_state", "modal_workflow_builder"]
      ]
    },
    {
      "task_name": "close_workflow_builder",
      "name": "close_workflow_editor",
      "preconditions": {"active_states_include": ["modal_workflow_builder"]},
      "actions": [
        ["click_element", "workflow-builder-close"],
        ["dismiss_dialog", "modal_workflow_builder"]
      ]
    },
    {
      "task_name": "run_workflow",
      "name": "run_workflow_from_builder",
      "preconditions": {"active_states_include": ["modal_workflow_builder"]},
      "actions": [
        ["click_element", "workflow-run-btn"],
        ["wait_for_state", "tab-active"]
      ]
    }
  ]
}
