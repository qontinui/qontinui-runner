{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '@@HOOK_SCRIPT@@'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '@@STOP_HOOK_SCRIPT@@'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["mcp__coord-mcp"]
  }
}
