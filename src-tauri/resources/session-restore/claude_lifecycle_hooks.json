{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@RUNNER_API_PORT@@/lifecycle/hook/Stop",
            "timeout": 1,
            "headers": {
              "X-Qontinui-Terminal": "$QONTINUI_TERMINAL_ID"
            },
            "allowedEnvVars": [
              "QONTINUI_TERMINAL_ID"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@RUNNER_API_PORT@@/lifecycle/hook/StopFailure",
            "timeout": 1,
            "headers": {
              "X-Qontinui-Terminal": "$QONTINUI_TERMINAL_ID"
            },
            "allowedEnvVars": [
              "QONTINUI_TERMINAL_ID"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@RUNNER_API_PORT@@/lifecycle/hook/SubagentStop",
