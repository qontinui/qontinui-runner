    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@RUNNER_API_PORT@@/lifecycle/hook/PreCompact",
            "timeout": 1,
            "headers": {
              "X-Qontinui-Terminal": "$QONTINUI_TERMINAL_ID"
            },
            "allowedEnvVars": [
              "QONTINUI_TERMINAL_ID"
