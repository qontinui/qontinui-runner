{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' async-sleeper",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@HTTP_PORT@@/hook/UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' async-sleeper",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:@@HTTP_PORT@@/hook/Stop",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '@@RECORDER@@' hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 '@@RECORDER@@' statusline"
  }
}
