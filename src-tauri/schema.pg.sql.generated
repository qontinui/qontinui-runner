-- Name: visual_comparison_results; Type: TABLE; Schema: project; Owner: -
--

CREATE TABLE project.visual_comparison_results (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    test_run_id uuid NOT NULL,
