import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import { UIBridgeProvider } from "@qontinui/ui-bridge";
import { kitCss } from "@qontinui/design-kit";

import App from "./App";
import "./index.css";

// The kit ships no skin: its stylesheet reads only the compiled `--dk-*` tokens.
const style = document.createElement("style");
style.textContent = kitCss();
document.head.appendChild(style);

createRoot(document.getElementById("root")!).render(
  <StrictMode>
    <UIBridgeProvider features={{ control: true }}>
      <App />
    </UIBridgeProvider>
  </StrictMode>,
);
