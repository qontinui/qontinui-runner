{
  "version": "1.0.0",
  "name": "Qontinui Runner Design System",
  "description": "Style guide for qontinui-runner Tauri desktop app. Validates components against the shared Qontinui design tokens and runner-specific layout/typography constants.",
  "tokens": {
    "colors": {
      "brand-primary": "#4A90D9",
      "brand-secondary": "#8B6BB5",
      "brand-success": "#4DB89D",
      "surface-canvas": "#111115",
      "surface-raised": "#1E1E22",
      "surface-hover": "#252529",
      "surface-active": "#2C2C32",
      "border-subtle": "#2A2A30",
      "border-default": "#3A3A42",
      "border-strong": "#4A4A54",
      "border-interactive": "#5A5A66",
      "text-primary": "#FFFFFF",
      "text-secondary": "#B4B4B4",
      "text-muted": "#8A8A8A",
      "text-inverse": "#111115",
      "semantic-success": "#4DB89D",
      "semantic-warning": "#E5A853",
      "semantic-error": "#E5534B",
      "semantic-info": "#4A90D9",
      "semantic-success-muted": "rgba(77, 184, 157, 0.15)",
      "semantic-warning-muted": "rgba(229, 168, 83, 0.15)",
      "semantic-error-muted": "rgba(229, 83, 75, 0.15)",
      "semantic-info-muted": "rgba(74, 144, 217, 0.15)",
      "glow-primary": "rgba(74, 144, 217, 0.2)",
      "glow-secondary": "rgba(139, 107, 181, 0.2)",
      "glow-success": "rgba(77, 184, 157, 0.2)"
    },
    "typography": {
      "fontFamilies": {
        "sans": "var(--font-geist-sans), system-ui, -apple-system, sans-serif",
        "mono": "var(--font-geist-mono), ui-monospace, monospace"
      },
      "fontSizes": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px"
      },
      "fontWeights": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeights": {
        "none": "1",
        "tight": "1.25",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625"
      },
      "letterSpacings": {
        "tighter": "-0.05em",
        "tight": "-0.025em",
        "normal": "0em",
        "wide": "0.025em",
        "wider": "0.05em",
        "widest": "0.1em"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "xxl": "32px",
      "xxxl": "48px"
    },
    "borderRadius": {
      "none": "0",
      "sm": "0.125rem",
      "default": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "full": "9999px"
    },
    "shadows": {
      "none": "none",
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "glow-primary": "0 0 12px rgba(74, 144, 217, 0.2)",
      "glow-secondary": "0 0 12px rgba(139, 107, 181, 0.2)",
      "glow-success": "0 0 12px rgba(77, 184, 157, 0.2)"
    },
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280,
      "2xl": 1536
    }
  },
  "rules": [
    {
      "id": "h1-typography",
      "description": "H1 elements must use 24px bold (text-2xl font-bold) per TYPOGRAPHY.h1.",
      "elementType": "heading",
      "constraints": [
        {
          "type": "exact",
          "property": "font-size",
          "value": "24px"
        },
        {
          "type": "exact",
          "property": "font-weight",
          "value": "700"
        }
      ],
      "severity": "error"
    },
    {
      "id": "h2-typography",
      "description": "H2 elements must use 20px semibold (text-xl font-semibold) per TYPOGRAPHY.h2.",
      "selector": "h2",
      "constraints": [
        {
          "type": "exact",
          "property": "font-size",
          "value": "20px"
        },
        {
          "type": "exact",
          "property": "font-weight",
          "value": "600"
        }
      ],
      "severity": "error"
    },
    {
      "id": "h3-typography",
      "description": "H3 elements must use 18px semibold (text-lg font-semibold) per TYPOGRAPHY.h3.",
      "selector": "h3",
      "constraints": [
        {
          "type": "exact",
          "property": "font-size",
          "value": "18px"
        },
        {
          "type": "exact",
          "property": "font-weight",
          "value": "600"
        }
      ],
      "severity": "error"
    },
    {
      "id": "body-text-size",
      "description": "Body text must use 14px (text-sm) per TYPOGRAPHY.body.",
      "selector": "p, .body-text",
      "constraints": [
        {
          "type": "oneOf",
          "property": "font-size",
          "values": ["14px", "0.875rem"]
        }
      ],
      "severity": "warning"
    },
    {
      "id": "badge-typography",
      "description": "Badges must use 12px medium (text-xs font-medium) per TYPOGRAPHY.badge.",
      "selector": ".badge",
      "constraints": [
        {
          "type": "oneOf",
          "property": "font-size",
          "values": ["12px", "0.75rem"]
        },
        {
          "type": "exact",
          "property": "font-weight",
          "value": "500"
        }
      ],
      "severity": "error"
    },
    {
      "id": "label-typography",
      "description": "Labels must use 14px or 12px medium per TYPOGRAPHY.label/labelSmall.",
      "selector": "label, .label",
      "constraints": [
        {
          "type": "oneOf",
          "property": "font-size",
          "values": ["12px", "14px", "0.75rem", "0.875rem"]
        },
        {
          "type": "exact",
          "property": "font-weight",
          "value": "500"
        }
      ],
      "severity": "warning"
    },
    {
      "id": "btn-font-weight",
      "description": "Buttons must use font-weight medium (500) for consistent appearance.",
      "selector": "button, [role=\"button\"]",
      "constraints": [
        {
          "type": "oneOf",
          "property": "font-weight",
          "values": ["500", "600"]
        }
      ],
      "severity": "error"
    },
    {
      "id": "btn-height",
      "description": "Buttons should use standard heights: 28px (sm), 36px (default), or 44px (lg) per COMPONENTS constants.",
      "selector": "button, [role=\"button\"]",
      "constraints": [
        {
          "type": "oneOf",
          "property": "height",
          "values": ["28px", "36px", "44px"]
        }
      ],
      "severity": "warning"
    },
    {
      "id": "btn-border-radius",
      "description": "Buttons must use border-radius lg (0.5rem / 8px) for rounded-lg appearance.",
      "selector": "button, [role=\"button\"]",
      "constraints": [
        {
          "type": "tokenRef",
          "property": "border-radius",
          "tokenPath": "borderRadius.lg"
        }
      ],
      "severity": "error"
    },
    {
      "id": "btn-cursor-pointer",
      "description": "Enabled buttons must show cursor: pointer.",
      "selector": "button:not([disabled]), [role=\"button\"]:not([aria-disabled=\"true\"])",
      "constraints": [
        {
          "type": "exact",
          "property": "cursor",
          "value": "pointer"
        }
      ],
      "severity": "warning"
    },
    {
      "id": "input-height",
      "description": "Inputs should use standard heights: 28px (sm), 36px (default), or 44px (lg) per COMPONENTS constants.",
      "selector": "input, textarea, select, .input",
      "constraints": [
        {
          "type": "oneOf",
          "property": "height",
          "values": ["28px", "36px", "44px"]
        }
      ],
      "severity": "warning"
    },
    {
      "id": "input-border-radius",
      "description": "Form inputs must use border-radius md (0.375rem / 6px) per the design system.",
      "selector": "input, textarea, select, .input",
      "constraints": [
        {
          "type": "tokenRef",
          "property": "border-radius",
          "tokenPath": "borderRadius.md"
        }
      ],
      "severity": "error"
    },
    {
      "id": "card-border-radius",
      "description": "Cards must use border-radius lg (0.5rem / 8px) per the design system.",
      "selector": ".card",
      "constraints": [
        {
          "type": "tokenRef",
          "property": "border-radius",
          "tokenPath": "borderRadius.lg"
        }
      ],
      "severity": "error"
    },
    {
      "id": "card-background",
      "description": "Cards should use surface-raised (#1E1E22) background.",
      "selector": ".card",
      "constraints": [
        {
          "type": "tokenRef",
          "property": "background-color",
          "tokenPath": "colors.surface-raised"
        }
      ],
      "severity": "warning"
    },
    {
      "id": "text-color-compliance",
      "description": "Text elements should use approved text colors from the design token palette.",
      "selector": "h1, h2, h3, h4, p, span, label",
      "constraints": [
        {
          "type": "oneOf",
          "property": "color",
          "values": [
            "#FFFFFF",
            "#ffffff",
            "rgb(255, 255, 255)",
            "#B4B4B4",
            "#b4b4b4",
            "rgb(180, 180, 180)",
            "#8A8A8A",
            "#8a8a8a",
            "rgb(138, 138, 138)",
            "#111115",
            "rgb(17, 17, 21)",
            "#4A90D9",
            "#4a90d9",
            "rgb(74, 144, 217)",
            "#8B6BB5",
            "#8b6bb5",
            "rgb(139, 107, 181)",
            "#4DB89D",
            "#4db89d",
            "rgb(77, 184, 157)",
            "#E5A853",
            "#e5a853",
            "rgb(229, 168, 83)",
            "#E5534B",
            "#e5534b",
            "rgb(229, 83, 75)",
            "inherit",
            "currentColor"
          ]
        }
      ],
      "severity": "warning"
    },
    {
      "id": "font-size-range",
      "description": "All font sizes should fall within the design system range of 12px to 30px.",
      "selector": "*",
      "constraints": [
        {
          "type": "range",
          "property": "font-size",
          "min": 12,
          "max": 30,
          "unit": "px"
        }
      ],
      "severity": "info"
    },
    {
      "id": "interactive-cursor",
      "description": "Interactive elements must show cursor: pointer.",
      "selector": "a[href], select, .tab-item, .sidebar-item",
      "constraints": [
        {
          "type": "exact",
          "property": "cursor",
          "value": "pointer"
        }
      ],
      "severity": "warning"
    }
  ]
}
