{
  "version": "1.0.0",
  "description": "Flow Control Settings Panel -- a workflow builder component (FlowControlPanel.tsx) for configuring per-workflow Inngest-inspired flow control policies and per-phase timeout overrides. Integrated into WorkflowEditor in qontinui-web. Produces two JSON strings (flow_control_json, phase_timeouts_json) persisted to unified_workflows table. At runtime, LoopController loads configs and enforces them: FlowControlEnforcer checks concurrency/throttle/debounce/rate-limit before admitting a workflow, and phase_timeout_ms enforces per-phase deadlines via check_timeout(). Backend: flow_control.rs, orchestrator/state.rs, loop_controller.rs, loop_handlers.rs, unified_workflows.rs, workflow_ops.rs, migrations v147.",
  "groups": [
    {
      "id": "fc-concurrency",
      "name": "Concurrency Limit Configuration",
      "description": "Controls max simultaneous instances of this workflow. When limit reached, new executions queue and wait (FlowControlDecision::Wait). Optionally scoped by key. Backend: FlowControl.concurrency (ConcurrencyLimit), enforced by FlowControlEnforcer.check(), tracked by record_start/record_end.",
      "category": "semantic",
      "assertions": [
        {
          "id": "fc-conc-heading",
          "description": "Concurrency section is clearly labeled",
          "category": "element-presence",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Concurrency"
            },
            "label": "Concurrency section heading"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-conc-limit-input",
          "description": "Users can set max concurrent executions via a numeric input",
          "category": "element-presence",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "spinbutton"
            },
            "label": "Concurrency limit number input"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-conc-limit-default",
          "description": "The concurrency limit defaults to a sensible value (e.g., 1 or empty) when no config exists",
          "category": "data-display",
          "severity": "warning",
          "assertionType": "semantic",
          "target": {
            "type": "search",
            "criteria": {
              "role": "spinbutton"
            },
            "label": "Default concurrency value"
          },
          "expected": "Input is empty or shows a placeholder when no flow_control_json is saved on the workflow",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-conc-scope-key",
          "description": "Users can optionally enter a scope key to apply limits per-key rather than globally",
          "category": "element-presence",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Scope key"
            },
            "label": "Scope key input label"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-conc-input-validation",
          "description": "The concurrency input only accepts positive integers; invalid values are rejected or clamped",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": {
              "role": "spinbutton"
            },
            "label": "Concurrency input validation"
          },
          "expected": "Input has min=1 attribute and type=number, preventing zero or negative values",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
