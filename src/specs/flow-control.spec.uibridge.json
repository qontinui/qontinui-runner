    {
      "id": "fc-persistence",
      "name": "Configuration Persistence and State Consistency",
      "description": "Settings serialize to JSON and persist as flow_control_json and phase_timeouts_json on unified_workflows. On save, WorkflowEditor PATCHes via MCP API. On load, LoopController reads for enforcement. Both SQLite (v147) and PostgreSQL store these fields.",
      "category": "state-consistency",
      "assertions": [
        {
          "id": "fc-persist-save",
          "description": "Changes persist when the workflow is saved, surviving page navigation and app restarts",
          "category": "state-consistency",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Concurrency"
            },
            "label": "Flow control settings persist on save"
          },
          "expected": "After setting concurrency=2, saving the workflow, navigating away, and returning, the concurrency input still shows 2. The workflow's flow_control_json contains '{\"concurrency\":{\"limit\":2}}'",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-persist-load-existing",
          "description": "When opening a workflow with existing flow_control_json, the panel pre-populates with saved values",
          "category": "state-consistency",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Concurrency"
            },
            "label": "Flow control loads from DB"
          },
          "expected": "If the workflow has flow_control_json='{\"concurrency\":{\"limit\":3},\"throttle\":{\"limit\":5,\"period_seconds\":60}}', the concurrency input shows 3 and throttle shows 5/1min",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-persist-null-handling",
          "description": "When flow_control_json is null/empty, all inputs show defaults or empty state, not errors",
          "category": "behavior",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Flow Control"
            },
            "label": "Null config handling"
          },
          "expected": "No console errors or broken UI when flow_control_json is null. All sections show their default/empty state",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "fc-persist-runtime-enforcement",
          "description": "Saved flow control settings are enforced at workflow execution time by the LoopController",
          "category": "state-consistency",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Flow Control"
            },
            "label": "Runtime enforcement consistency"
          },
          "expected": "If concurrency limit=1 is saved and two instances of the workflow are triggered, the second one waits (FlowControlDecision::Wait) until the first completes. The wait is logged in the runner console.",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
