              "textContent": "Phase Timeouts"
            },
            "label": "Phase timeouts change callback"
          },
          "expected": "After setting execution timeout to 45 minutes, the parent receives '{\"execution_ms\":2700000}'. Values are converted from minutes to milliseconds for the backend",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    }
