{
  "version": "1.0.0",
  "description": "GraphQL Dashboard Integration — the Active Dashboard's stop/pause/resume controls use GraphQL mutations. The orchestration loop banner uses a GraphQL subscription for phase detection. The connection health badge uses a health subscription. Dashboard data refreshes are triggered by subscription events rather than blind polling.",
  "preconditions": [
    "Runner API is healthy",
    "At least one task run exists (running preferred for full coverage)"
  ],
  "page": "Active Dashboard",
  "groups": [
    {
      "id": "graphql-dash-controls",
      "name": "Mutation-Backed Lifecycle Controls",
      "description": "The dashboard control bar's stop, pause, and resume actions use GraphQL mutations. The mutation result automatically updates the cache.",
      "category": "interaction",
      "assertions": [
        {
          "id": "graphql-dash-stop",
          "description": "The Stop button terminates the running workflow. Status transitions to 'stopped'.",
          "category": "interaction",
          "severity": "critical",
          "assertionType": "stateChange",
          "precondition": "A task is running",
          "expected": "Task status changes to 'stopped' within 2 seconds",
          "target": {
            "type": "search",
            "criteria": { "role": "button", "textContent": "Stop" },
            "label": "Stop button"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "graphql-dash-pause-resume",
          "description": "Pause suspends the workflow. Resume continues it. The control bar updates to reflect the current state.",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "stateChange",
          "precondition": "A task is running",
          "expected": "Pause → status 'paused', Resume → status 'running'",
          "target": {
            "type": "search",
            "criteria": { "role": "button" },
            "label": "Pause/Resume control"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "graphql-dash-updates",
      "name": "Subscription-Driven Updates",
      "description": "Dashboard data refreshes when events arrive via subscription, not on a fixed polling interval.",
      "category": "behavior",
      "assertions": [
        {
          "id": "graphql-dash-instant-status",
          "description": "Task status changes (completion, failure, stop) are reflected in the dashboard within 2 seconds",
          "category": "behavior",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": { "textContent": "complete|failed|stopped" },
            "label": "Fast status reflection"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "graphql-dash-consistent-state",
          "description": "After stopping a task, all dashboard widgets show consistent 'stopped' state — no widget shows stale 'running'",
          "category": "state-consistency",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": { "textContent": "stopped" },
            "label": "Consistent state across widgets"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "graphql-dash-loop",
      "name": "Orchestration Loop Banner",
      "description": "A banner appears at the top of the dashboard when an orchestration loop is running. Shows phase, iteration progress, and control buttons. Phase updates are driven by a GraphQL subscription.",
      "precondition": "An orchestration loop is running (workflow with max_iterations > 1)",
      "category": "semantic",
      "assertions": [
        {
          "id": "graphql-dash-loop-phase",
          "description": "The banner shows the current phase name: Building, Executing, Reflecting, Fixing, Evaluating, Complete, or Stopped",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Building|Executing|Reflecting|Fixing|Evaluating|Complete|Stopped"
            },
            "label": "Phase label"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "graphql-dash-loop-iteration",
          "description": "Iteration progress shows as 'current/max' (e.g., '2/5')",
          "category": "data-display",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": { "textContent": "/" },
            "label": "Iteration counter"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "graphql-dash-loop-not-shown-when-idle",
          "description": "The banner does not appear when no orchestration loop is running",
          "category": "state-consistency",
          "severity": "warning",
          "assertionType": "not-exists",
          "precondition": "No orchestration loop is running",
          "target": {
            "type": "search",
            "criteria": { "textContent": "Building|Executing|Reflecting" },
            "label": "Banner absent when idle"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "graphql-dash-connection",
      "name": "Connection Health Badge",
      "description": "The bottom bar shows a connection status indicator powered by a GraphQL health subscription. Falls back to REST polling if the subscription is unavailable.",
      "category": "semantic",
      "assertions": [
        {
          "id": "graphql-dash-connection-visible",
          "description": "A connection status indicator is visible in the bottom bar",
          "category": "element-presence",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": { "textContent": "Connected|Disconnected" },
            "label": "Connection badge"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    }
  ],
  "stateMachine": {
    "states": [
      {
        "id": "idle",
        "name": "Idle — No Running Task",
        "description": "No task is running. The dashboard control bar has no active controls. The orchestration loop banner is hidden. The connection badge shows Connected or Disconnected.",
        "elements": [{ "textContent": "Connected|Disconnected" }],
        "isInitial": true,
        "transitions": [
          {
            "id": "idle-to-running",
            "name": "A task run starts (externally triggered or via another page)",
            "activateStates": ["running"],
            "deactivateStates": ["idle"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "running",
        "name": "Running — Task Actively Executing",
        "description": "A task is running. The control bar shows Stop and Pause buttons. Status widgets reflect 'running'. If the task is part of an orchestration loop, the loop banner is also visible.",
        "elements": [{ "role": "button", "textContent": "Stop" }],
        "isInitial": false,
        "transitions": [
          {
            "id": "running-to-paused",
            "name": "Pause the running task via the Pause button",
            "activateStates": ["paused"],
            "deactivateStates": ["running"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Pause" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "running-to-stopped",
            "name": "Stop the running task via the Stop button",
            "activateStates": ["stopped"],
            "deactivateStates": ["running"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Stop" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "running-to-loop-active",
            "name": "Orchestration loop starts (task has max_iterations > 1)",
            "activateStates": ["loop-active"],
            "deactivateStates": ["running"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "running-to-terminal",
            "name": "Task completes or fails automatically",
            "activateStates": ["terminal"],
            "deactivateStates": ["running"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "paused",
        "name": "Paused — Task Suspended",
        "description": "The task is paused. The control bar shows Resume and Stop buttons. Widgets show 'paused' status consistently.",
        "elements": [{ "textContent": "paused" }],
        "isInitial": false,
        "transitions": [
          {
            "id": "paused-to-running",
            "name": "Resume the paused task via the Resume button",
            "activateStates": ["running"],
            "deactivateStates": ["paused"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Resume" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "paused-to-stopped",
            "name": "Stop the task while paused",
            "activateStates": ["stopped"],
            "deactivateStates": ["paused"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Stop" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          }
        ]
      },
      {
        "id": "loop-active",
        "name": "Loop Active — Orchestration Loop Running",
        "description": "An orchestration loop is running. The banner shows the current phase (Building, Executing, Reflecting, Fixing, Evaluating) and iteration progress (e.g. '2/5'). Stop and Pause controls are available.",
        "elements": [
          { "textContent": "Building|Executing|Reflecting|Fixing|Evaluating" },
          { "textContent": "/" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "loop-active-to-stopped",
            "name": "Stop the workflow during orchestration loop",
            "activateStates": ["stopped"],
            "deactivateStates": ["loop-active"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Stop" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "loop-active-to-terminal",
            "name": "Orchestration loop completes all iterations",
            "activateStates": ["terminal"],
            "deactivateStates": ["loop-active"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "stopped",
        "name": "Stopped — Task Manually Stopped",
        "description": "The task was stopped by the user. All widgets consistently show 'stopped' status. The orchestration loop banner (if present) disappears. The connection badge remains visible.",
        "elements": [{ "textContent": "stopped" }],
        "isInitial": false,
        "transitions": [
          {
            "id": "stopped-to-idle",
            "name": "Navigate away or select a different task",
            "activateStates": ["idle"],
            "deactivateStates": ["stopped"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "terminal",
        "name": "Terminal — Task Completed or Failed",
        "description": "The task reached a terminal state (complete or failed) automatically. All widgets show the final status. The loop banner is hidden.",
        "elements": [{ "textContent": "complete|failed" }],
        "isInitial": false,
        "transitions": [
          {
            "id": "terminal-to-idle",
            "name": "Navigate away or select a different task",
            "activateStates": ["idle"],
            "deactivateStates": ["terminal"],
            "staysVisible": false,
            "process": []
          }
        ]
      }
    ]
  }
}
