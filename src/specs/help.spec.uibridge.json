{
  "version": "1.0.0",
  "description": "Help page",
  "groups": [
    {
      "id": "help-purpose",
      "name": "Page Purpose",
      "description": "The Help page is the primary learning and support resource within the runner application.",
      "category": "semantic",
      "assertions": [
        {
          "id": "help-purpose-learn",
          "description": "Users can access structured learning resources to understand how to use the runner features effectively",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Help"
            },
            "label": "Help page heading"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "help-purpose-sections",
          "description": "Users can navigate between help sections (Tutorials, Shortcuts, Getting Started, Documentation, Troubleshooting, About)",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "role": "tablist"
            },
            "label": "Help section tabs"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "help-tutorials",
      "name": "Tutorial Goals",
      "description": "Users need interactive guided tutorials that walk them through key workflows step by step.",
      "category": "semantic",
      "assertions": [
        {
          "id": "help-tutorials-browse",
          "description": "Users can browse available tutorials with descriptions of what each tutorial teaches",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Tutorials"
            },
            "label": "Tutorials section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "help-tutorials-start",
          "description": "Users can start an interactive tutorial that guides them through the application",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "role": "button",
              "textContent": "Start"
            },
            "label": "Start tutorial"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "help-shortcuts",
      "name": "Keyboard Shortcuts Goals",
      "description": "Power users need quick reference to all keyboard shortcuts organized by feature area.",
      "category": "semantic",
      "assertions": [
        {
          "id": "help-shortcuts-list",
          "description": "Users can view a comprehensive list of all keyboard shortcuts organized by feature area",
          "category": "semantic",
          "severity": "warning",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Shortcuts"
            },
            "label": "Shortcuts section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "help-troubleshooting",
      "name": "Troubleshooting and Support Goals",
      "description": "When users encounter problems they need quick access to common issue solutions and debugging guidance.",
      "category": "semantic",
      "assertions": [
        {
          "id": "help-troubleshoot-issues",
          "description": "Users can find solutions to common issues and error messages",
          "category": "semantic",
          "severity": "warning",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Troubleshooting"
            },
            "label": "Troubleshooting section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "help-about-version",
          "description": "Users can view the current application version, build information, and credits",
          "category": "semantic",
          "severity": "info",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "About"
            },
            "label": "About section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    }
  ],
  "stateMachine": {
    "states": [
      {
        "id": "help-tutorials-view",
        "name": "Tutorials Tab Active",
        "description": "The Tutorials sub-page is displayed, showing available interactive tutorial cards. Each card shows the tutorial name, description, and a Start button. This is the default landing state when the Help page is opened.",
        "elements": [{ "textContent": "Tutorials" }, { "role": "button", "textContent": "Start" }],
        "isInitial": true,
        "transitions": [
          {
            "id": "tutorials-to-tutorial-active",
            "name": "Start a tutorial",
            "description": "User clicks the Start button on a tutorial card, launching the interactive tutorial overlay that guides the user step by step",
            "activateStates": ["help-tutorial-active"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Start" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "tutorials-to-product-tours",
            "name": "Switch to Product Tours tab",
            "description": "User clicks the Product Tours tab to view available guided product tours",
            "activateStates": ["help-product-tours-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Product Tours" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tutorials-to-shortcuts",
            "name": "Switch to Shortcuts tab",
            "description": "User clicks the Shortcuts tab to view keyboard shortcuts reference",
            "activateStates": ["help-shortcuts-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Shortcuts" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tutorials-to-getting-started",
            "name": "Switch to Getting Started tab",
            "description": "User clicks the Getting Started tab to view the onboarding guide",
            "activateStates": ["help-getting-started-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Getting Started" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tutorials-to-documentation",
            "name": "Switch to Documentation tab",
            "description": "User clicks the Documentation tab to view external documentation links",
            "activateStates": ["help-documentation-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Documentation" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tutorials-to-troubleshooting",
            "name": "Switch to Troubleshooting tab",
            "description": "User clicks the Troubleshooting tab to view common issues and solutions",
            "activateStates": ["help-troubleshooting-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Troubleshooting" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tutorials-to-about",
            "name": "Switch to About tab",
            "description": "User clicks the About tab to view version info and credits",
            "activateStates": ["help-about-view"],
            "deactivateStates": ["help-tutorials-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "About" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-tutorial-active",
        "name": "Tutorial In Progress",
        "description": "An interactive tutorial is actively running, displaying step-by-step guidance overlaying the application. The tutorial highlights UI elements and provides instructions for each step.",
        "elements": [{ "textContains": "Step" }],
        "transitions": [
          {
            "id": "tutorial-active-to-tutorials",
            "name": "Exit tutorial",
            "description": "User completes or exits the active tutorial, returning to the tutorials list view",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-tutorial-active"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "help-product-tours-view",
        "name": "Product Tours Tab Active",
        "description": "The Product Tours sub-page is displayed, showing available guided tours. Each tour card shows the tour name, audience, and action buttons.",
        "elements": [{ "textContent": "Product Tours" }],
        "transitions": [
          {
            "id": "product-tours-to-tour-playing",
            "name": "Start a product tour",
            "description": "User starts a product tour, launching the tour player that walks through application features",
            "activateStates": ["help-tour-playing"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": []
          },
          {
            "id": "product-tours-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-product-tours-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-tour-playing",
        "name": "Product Tour In Progress",
        "description": "A product tour is actively playing, displaying a step-by-step guided walkthrough of application features with navigation controls.",
        "elements": [{ "role": "button", "textContent": "Next" }],
        "transitions": [
          {
            "id": "tour-playing-to-product-tours",
            "name": "Exit product tour",
            "description": "User completes or exits the product tour, returning to the product tours list",
            "activateStates": ["help-product-tours-view"],
            "deactivateStates": ["help-tour-playing"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "help-shortcuts-view",
        "name": "Shortcuts Tab Active",
        "description": "The Shortcuts sub-page is displayed, showing a categorized list of keyboard shortcuts. Each category contains shortcut entries with key combinations, descriptions, and context information.",
        "elements": [{ "textContent": "Shortcuts" }, { "textContains": "Keyboard" }],
        "transitions": [
          {
            "id": "shortcuts-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-shortcuts-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-getting-started-view",
        "name": "Getting Started Tab Active",
        "description": "The Getting Started sub-page is displayed, showing an onboarding checklist with quick-start steps and first-run guidance for new users.",
        "elements": [{ "textContent": "Getting Started" }],
        "transitions": [
          {
            "id": "getting-started-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-getting-started-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-documentation-view",
        "name": "Documentation Tab Active",
        "description": "The Documentation sub-page is displayed, showing a grid of external documentation links. Each link card shows a title, description, and an external link icon.",
        "elements": [{ "textContent": "Documentation" }, { "textContains": "External" }],
        "transitions": [
          {
            "id": "documentation-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-documentation-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-troubleshooting-view",
        "name": "Troubleshooting Tab Active",
        "description": "The Troubleshooting sub-page is displayed, showing a list of common issues. Each issue has a title, description, and expandable solution steps.",
        "elements": [{ "textContent": "Troubleshooting" }, { "textContains": "Common" }],
        "transitions": [
          {
            "id": "troubleshooting-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-troubleshooting-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "help-about-view",
        "name": "About Tab Active",
        "description": "The About sub-page is displayed, showing the application version number, build information, credits, and links to the project repository.",
        "elements": [{ "textContent": "About" }, { "textContains": "Version" }],
        "transitions": [
          {
            "id": "about-to-tutorials",
            "name": "Switch to Tutorials tab",
            "description": "User clicks the Tutorials tab",
            "activateStates": ["help-tutorials-view"],
            "deactivateStates": ["help-about-view"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Tutorials" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      }
    ]
  },
