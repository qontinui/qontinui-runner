{
  "version": "1.0.0",
  "description": "Run Summary page — the primary post-run analysis view where users understand what happened during a workflow run. Combines AI-generated summaries, status banners, token usage, failure details, and tabbed deep-dive sections (Timeline, Verification, Knowledge, Context, Canvas, Errors).",
  "groups": [
    {
      "id": "summary-run-outcome",
      "name": "Run Outcome at a Glance",
      "description": "When a user navigates to the Summary page after a workflow completes, they need to immediately understand the outcome. The page should communicate whether the run succeeded, failed, or was stopped, along with the AI-generated narrative of what was accomplished. This is the most critical information on the page because it determines whether the user needs to take further action or can move on to another task.",
      "category": "semantic",
      "assertions": [
        {
          "id": "summary-outcome-status-visible",
          "description": "The user can immediately determine the overall run status (complete, failed, or stopped) from a prominent status indicator displayed near the top of the page, without needing to scroll or click into sub-sections",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "complete|failed|stopped",
              "role": "status"
            },
            "label": "Run status indicator"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-outcome-ai-summary",
          "description": "The user can read an AI-generated narrative summary that explains what was accomplished during the run, providing a human-readable description of the work done rather than just raw status codes",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Summary"
            },
            "label": "AI summary section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-outcome-goal-achievement",
          "description": "The user can see whether the stated goal of the workflow was achieved or not, displayed as a clear indicator so they know if follow-up work is needed",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Goal"
            },
            "label": "Goal achievement indicator"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-outcome-duration-timing",
          "description": "The user can see how long the run took, including start and end times, so they can assess execution performance and plan future workflow scheduling",
          "category": "semantic",
          "severity": "minor",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "session"
            },
            "label": "Session and timing stats"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "summary-failure-analysis",
      "name": "Failure Analysis and Recovery",
      "description": "When a workflow run fails, users need to understand what went wrong and have options for recovery. The Summary page should prominently display failure details for failed runs and offer a way to continue the run with additional iterations. This is essential for iterative development workflows where partial progress is common and users want to pick up where they left off rather than starting over.",
      "category": "semantic",
      "assertions": [
        {
          "id": "summary-failure-details-shown",
          "description": "When a run has failed, the user sees a dedicated failure section that explains the error, its cause, and the phase where the failure occurred, so they can diagnose the problem without digging through logs",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Failure|Error|failed"
            },
            "label": "Failure section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-failure-continue-run",
          "description": "For finished runs (complete, failed, or stopped), the user can continue the run by specifying additional sessions, allowing iterative progress without losing context from previous iterations",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "role": "button",
              "textContent": "Continue"
            },
            "label": "Continue run button"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-failure-token-usage",
          "description": "The user can view token usage and cost information for the run, helping them understand resource consumption and optimize future workflow configurations",
          "category": "semantic",
          "severity": "minor",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "usage|token|cost"
            },
            "label": "Token usage section"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "summary-tabbed-deep-dives",
      "name": "Tabbed Deep-Dive Sections",
      "description": "Beyond the top-level summary, users need to drill into specific aspects of the run. The tabbed interface provides organized access to the execution timeline, verification results, knowledge entries, context variables, canvas artifacts, and error monitoring. Each tab serves a distinct analytical purpose, and users should be able to switch between them fluidly to build a complete picture of what happened.",
      "category": "semantic",
      "assertions": [
        {
          "id": "summary-tabs-timeline-available",
          "description": "The user can switch to the Timeline tab to see a step-by-step execution history grouped by workflow phase (setup, verification, agentic, completion), giving them a chronological understanding of the run's progression",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Timeline"
            },
            "label": "Timeline tab trigger"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-tabs-verification-available",
          "description": "The user can switch to the Verification tab to review the verification plan and its results, understanding which checks passed, which failed, and how verification outcomes influenced the workflow loop",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Verification"
            },
            "label": "Verification tab trigger"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-tabs-knowledge-available",
          "description": "The user can switch to the Knowledge tab to see findings and knowledge entries that were generated during execution, helping them capture lessons learned and improve future workflows",
          "category": "semantic",
          "severity": "minor",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Knowledge"
            },
            "label": "Knowledge tab trigger"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-tabs-context-available",
          "description": "The user can switch to the Context tab to inspect variables, retry history, and other contextual data that was available during execution, aiding in debugging and workflow refinement",
          "category": "semantic",
          "severity": "minor",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Context"
            },
            "label": "Context tab trigger"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-tabs-canvas-available",
          "description": "The user can switch to the Canvas tab to view visual artifacts and canvas-based recap data generated during the run, providing a spatial or visual representation of execution results",
          "category": "semantic",
          "severity": "minor",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Canvas"
            },
            "label": "Canvas tab trigger"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "summary-empty-and-loading-states",
      "name": "Empty and Loading States",
      "description": "The Summary page must gracefully handle states where data is not yet available. When a run is loading, the user should see clear progress indication. When no run is selected or no recap data exists, the page should guide the user toward selecting a run or initiating one. These states prevent confusion and ensure the user always knows what to do next.",
      "category": "semantic",
      "assertions": [
        {
          "id": "summary-loading-feedback",
          "description": "While recap data is being fetched, the user sees a clear loading indicator that confirms data retrieval is in progress, preventing them from thinking the page is broken",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Loading"
            },
            "label": "Loading state indicator"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-no-data-guidance",
          "description": "When no recap data is available (no run selected or run has no data), the user sees a helpful message guiding them to select a run or execute a task first, rather than showing a blank page",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Select a run"
            },
            "label": "No data guidance message"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "summary-error-state-recovery",
          "description": "When recap data fails to load, the user sees a clear error message explaining what went wrong, allowing them to understand the issue and potentially retry",
          "category": "semantic",
          "severity": "major",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Failed to load"
            },
            "label": "Error state message"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "summary-verification-pagination",
      "name": "Verification Results Pagination",
      "description": "The Verification tab paginates iteration results (20 per page) to handle runs with many verification iterations. The latest visible iteration is auto-expanded. A 'Show more' button loads additional iterations.",
      "category": "state-consistency",
      "assertions": [
        {
          "id": "summary-verification-show-more",
          "description": "When more than 20 verification iterations exist, a 'Show more' button appears at the bottom of the iterations list showing the remaining count. Clicking loads the next 20 iterations.",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "behavior",
          "precondition": "A task run with >20 verification iterations is selected and Verification tab is active",
          "target": {
            "type": "search",
            "criteria": { "textContains": "Show more" },
            "label": "Verification iterations Show More"
          },
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "summary-verification-last-expanded",
          "description": "The last visible verification iteration is automatically expanded to show its step results, so users immediately see the most recent verification outcome without clicking.",
          "category": "behavior",
          "severity": "warning",
          "assertionType": "semantic",
          "precondition": "At least one verification iteration exists",
          "target": {
            "type": "search",
            "criteria": { "textContains": "Iteration" },
            "label": "Auto-expanded latest iteration"
          },
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "summary-task-output-virtualized",
          "description": "The TaskRunLivePanel output preview uses virtualized line rendering (react-window) to handle large output. Lines are split and rendered individually, capped at 128px height. A 'Load more' button fetches additional output from the backend.",
          "category": "state-consistency",
          "severity": "warning",
          "assertionType": "semantic",
          "precondition": "A task run with output is visible in the panel",
          "target": {
            "type": "search",
            "criteria": { "textContains": "Output" },
            "label": "Virtualized output preview"
          },
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        }
      ],
      "source": "ai-generated"
    }
  ],
  "stateMachine": {
    "states": [
      {
        "id": "loading",
        "name": "Loading — Fetching Recap Data",
        "description": "Recap data is being fetched. The page shows a pulsing activity icon and 'Loading recap...' text. No run content or tabs are visible.",
        "elements": [{ "textContains": "Loading recap" }],
        "isInitial": true,
        "transitions": [
          {
            "id": "loading-to-run-loaded",
            "name": "Recap data loads successfully",
            "activateStates": ["run-loaded"],
            "deactivateStates": ["loading"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "loading-to-error",
            "name": "Recap data fails to load",
            "activateStates": ["error"],
            "deactivateStates": ["loading"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "loading-to-no-data",
            "name": "No recap data available for the selected run",
            "activateStates": ["no-data"],
            "deactivateStates": ["loading"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "error",
        "name": "Error — Failed to Load Recap",
        "description": "An error occurred while fetching recap data. The page shows a red X icon, 'Failed to load recap' heading, and the error message.",
        "elements": [{ "textContains": "Failed to load recap" }],
        "isInitial": false,
        "transitions": []
      },
      {
        "id": "no-data",
        "name": "No Data — No Run Selected or No Recap",
        "description": "No recap data is available. The page shows a guidance message prompting the user to select a run or execute a task first.",
        "elements": [{ "textContains": "No Recap Data" }],
        "isInitial": false,
        "transitions": [
          {
            "id": "no-data-to-loading",
            "name": "User selects a run from the sidebar",
            "activateStates": ["loading"],
            "deactivateStates": ["no-data"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "run-loaded",
        "name": "Run Loaded — Summary and Tabs Visible",
        "description": "Recap data has loaded. The page displays the compact status strip, AI summary, run details sidebar, and the tabbed content area. The Timeline tab is active by default. Failure section appears when the run has failed.",
        "elements": [
          { "textContains": "Timeline" },
          { "textContains": "Verification" },
          { "textContains": "Knowledge" },
          { "textContains": "Context" },
          { "textContains": "Canvas" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "run-loaded-to-loading",
            "name": "User selects a different run, triggering a reload",
            "activateStates": ["loading"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "run-loaded-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Timeline" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-verification",
            "name": "Switch to Verification tab",
            "activateStates": ["tab-verification"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Verification" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-knowledge",
            "name": "Switch to Knowledge tab",
            "activateStates": ["tab-knowledge"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Knowledge" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-context",
            "name": "Switch to Context tab",
            "activateStates": ["tab-context"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Context" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-canvas",
            "name": "Switch to Canvas tab",
            "activateStates": ["tab-canvas"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Canvas" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-durable",
            "name": "Switch to Diffs & Replay tab",
            "activateStates": ["tab-durable"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContains": "Diffs" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-feedback",
            "name": "Switch to Feedback Scores tab",
            "activateStates": ["tab-feedback"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContains": "Feedback Scores" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-llm-costs",
            "name": "Switch to LLM Costs tab",
            "activateStates": ["tab-llm-costs"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContains": "LLM Costs" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "run-loaded-to-tab-errors",
            "name": "Switch to Errors tab",
            "activateStates": ["tab-errors"],
            "deactivateStates": ["run-loaded"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContains": "Errors" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "tab-timeline",
        "name": "Tab — Timeline Active",
        "description": "The Timeline tab is selected, showing staged or step-by-step execution history grouped by workflow phase.",
        "elements": [
          { "tagName": "div", "dataAttributes": { "state": "active" }, "textContains": "Timeline" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-timeline-to-tab-verification",
            "name": "Switch to Verification tab",
            "activateStates": ["tab-verification"],
            "deactivateStates": ["tab-timeline"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Verification" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tab-timeline-to-loading",
            "name": "User selects a different run",
            "activateStates": ["loading"],
            "deactivateStates": ["tab-timeline"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "tab-verification",
        "name": "Tab — Verification Active",
        "description": "The Verification tab is selected, showing the verification plan and iteration results with pass/fail details.",
        "elements": [
          {
            "tagName": "div",
            "dataAttributes": { "state": "active" },
            "textContains": "Verification"
          }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-verification-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["tab-verification"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Timeline" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tab-verification-to-loading",
            "name": "User selects a different run",
            "activateStates": ["loading"],
            "deactivateStates": ["tab-verification"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "tab-knowledge",
        "name": "Tab — Knowledge Active",
        "description": "The Knowledge tab is selected, showing findings and knowledge entries generated during execution.",
        "elements": [
          { "tagName": "div", "dataAttributes": { "state": "active" }, "textContains": "Knowledge" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-knowledge-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["tab-knowledge"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Timeline" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tab-knowledge-to-loading",
            "name": "User selects a different run",
            "activateStates": ["loading"],
            "deactivateStates": ["tab-knowledge"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "tab-context",
        "name": "Tab — Context Active",
        "description": "The Context tab is selected, showing variables, retry history, and contextual data from execution.",
        "elements": [
          { "tagName": "div", "dataAttributes": { "state": "active" }, "textContains": "Context" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-context-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["tab-context"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Timeline" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tab-context-to-loading",
            "name": "User selects a different run",
            "activateStates": ["loading"],
            "deactivateStates": ["tab-context"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "tab-canvas",
        "name": "Tab — Canvas Active",
        "description": "The Canvas tab is selected, showing visual artifacts and canvas-based recap data.",
        "elements": [
          { "tagName": "div", "dataAttributes": { "state": "active" }, "textContains": "Canvas" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-canvas-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["tab-canvas"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "tab", "textContent": "Timeline" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "tab-canvas-to-loading",
            "name": "User selects a different run",
            "activateStates": ["loading"],
            "deactivateStates": ["tab-canvas"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "tab-durable",
        "name": "Tab — Diffs & Replay Active",
        "description": "The Diffs & Replay tab is selected, showing durable execution diffs and replay controls.",
        "elements": [
          { "tagName": "div", "dataAttributes": { "state": "active" }, "textContains": "Diffs" }
        ],
        "isInitial": false,
        "transitions": [
          {
            "id": "tab-durable-to-tab-timeline",
            "name": "Switch to Timeline tab",
            "activateStates": ["tab-timeline"],
            "deactivateStates": ["tab-durable"],
            "staysVisible": false,
            "process": [
