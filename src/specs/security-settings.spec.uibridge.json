{
  "version": "1.0.0",
  "description": "Security & Sandboxing settings page. Configures agent sandboxing policies following the AST 7-layer defense model: compute isolation, resource limits, filesystem boundaries, network mediation, credential proxy, action governance, and audit logging. Supports three built-in profiles (permissive/standard/strict) plus a custom profile editor with full sub-policy configuration.",
  "groups": [
    {
      "id": "sec-page-header",
      "name": "Page Header & Title",
      "description": "The page header shows the Shield icon, title 'Security & Sandboxing', and subtitle description.",
      "category": "element-presence",
      "assertions": [
        {
          "id": "sec-header-title",
          "description": "The page heading 'Security & Sandboxing' is displayed at the top",
          "category": "element-presence",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": { "role": "heading", "textContains": "Security" },
            "label": "Page title"
          },
          "assertionType": "containsText",
          "expected": "Security & Sandboxing",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "sec-header-subtitle",
          "description": "Subtitle text explains the page purpose: sandbox constraints for workflow execution",
          "category": "element-presence",
          "severity": "info",
          "target": {
            "type": "search",
            "criteria": { "textContains": "sandbox constraints" },
            "label": "Subtitle"
          },
          "assertionType": "exists",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        }
      ],
      "source": "ai-generated"
    },
