  "stateMachine": {
    "states": [
      {
        "id": "loading",
        "name": "Loading",
        "description": "Initial loading state while security settings are fetched from the backend. Shows a centered loading message instead of the form.",
        "elements": [{ "textContent": "Loading security settings" }],
        "isInitial": true,
        "transitions": [
          {
            "id": "loading-to-builtin-profile",
            "name": "Settings loaded with built-in profile",
            "activateStates": ["builtin-profile"],
            "deactivateStates": ["loading"],
            "staysVisible": false,
            "process": [
              {
                "action": "wait",
                "waitAfter": { "type": "idle", "timeout": 3000 }
              }
            ]
          }
        ]
      },
      {
        "id": "builtin-profile",
        "name": "Built-in Profile Selected",
        "description": "A built-in security profile (Permissive, Standard, or Strict) is selected. The profile description, AST fingerprint, and 7-layer security posture visualization are visible. The custom policy editor is hidden.",
        "elements": [
          { "textContent": "Security Profile" },
          { "textContent": "Security Posture" },
          { "textContent": "AST Fingerprint" },
          { "textContent": "Features" }
        ],
        "isInitial": false,
        "transitions": [
