{
  "version": "1.0.0",
  "description": "Settings page",
  "groups": [
    {
      "id": "settings-purpose",
      "name": "Page Purpose",
      "description": "The Settings page is the central configuration hub for the entire runner application.",
      "category": "semantic",
      "assertions": [
        {
          "id": "settings-purpose-hub",
          "description": "Users can access all application configuration from a single organized settings hub with categorized sub-pages",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Settings"
            },
            "label": "Settings heading"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "settings-purpose-navigate",
          "description": "Users can navigate between setting categories using a secondary sidebar",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "role": "navigation"
            },
            "label": "Settings navigation"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "settings-ai-config",
      "name": "AI Provider Configuration Goals",
      "description": "Users need to configure which AI providers and models power their automation workflows.",
      "category": "semantic",
      "assertions": [
        {
          "id": "settings-ai-provider",
          "description": "Users can configure AI providers with API keys and select models for workflow execution",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "AI"
            },
            "label": "AI settings"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "settings-ai-model",
          "description": "Users can select default AI models and override per workflow",
          "category": "semantic",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Model"
            },
            "label": "Model selection"
          },
          "assertionType": "exists",
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "settings-claude-accounts",
      "name": "Claude Account Switching",
      "description": "The AI tab's Claude Accounts section supports multi-account management with automatic failover on rate-limit. Users can see which account is active, which are rate-limited, and manually switch between accounts. When in Least Usage mode, the runner auto-selects the best account at startup and auto-rotates on rate-limit during workflows.",
      "category": "interaction",
      "assertions": [
        {
          "id": "settings-claude-accounts-heading",
          "description": "The Claude Accounts section is visible within the AI Providers tab, showing a Users icon and 'Claude Accounts' heading",
          "category": "element-presence",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Claude Accounts"
            },
            "label": "Claude Accounts section heading"
          },
          "assertionType": "exists",
          "precondition": "AI Providers tab is selected",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "settings-claude-active-badge",
          "description": "The currently active account (used by the runner at runtime) displays a blue 'Active' badge. Exactly one account should have this badge at any time when accounts are configured.",
          "category": "element-presence",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Active"
            },
            "label": "Active account badge"
          },
          "assertionType": "exists",
          "precondition": "AI Providers tab is selected and at least one Claude account directory is configured",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "settings-claude-switch-button",
          "description": "Non-active accounts show a 'Switch' button that allows manually switching to that account. Clicking Switch calls the switch_claude_account Tauri command, clears any cooldown on the target account, and refreshes the live account state to reflect the new active account.",
          "category": "interaction",
          "severity": "critical",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Switch"
            },
            "label": "Account switch button"
          },
          "assertionType": "behavior",
          "precondition": "AI Providers tab is selected and at least two Claude account directories are configured",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "settings-claude-rate-limited-badge",
          "description": "When an account has been rate-limited (hit token/usage limits), it displays a red 'Rate-limited' badge. The badge appears based on live backend state from get_claude_accounts, not from the usage check.",
          "category": "state-consistency",
          "severity": "warning",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Rate-limited"
            },
            "label": "Rate-limited badge"
          },
          "assertionType": "exists",
          "precondition": "AI Providers tab is selected, at least one account is in cooldown from a rate-limit hit",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "settings-claude-selection-mode",
          "description": "When two or more accounts are configured, a Selection Mode section appears with Manual and Least Usage options. Least Usage mode description reads 'Auto-select & failover on rate-limit', indicating the runner will auto-select the best account at startup and auto-rotate when one hits a rate limit during workflows.",
          "category": "element-presence",
          "severity": "warning",
          "target": {
            "type": "search",
            "criteria": {
              "textContains": "failover on rate-limit"
            },
            "label": "Least Usage mode description"
          },
          "assertionType": "exists",
          "precondition": "AI Providers tab is selected and at least two Claude account directories are configured",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        },
        {
          "id": "settings-claude-switch-shows-spinner",
          "description": "When the Switch button is clicked, the targeted account's button shows 'Switching...' text with a spinning icon while the backend processes the switch. All other Switch buttons are disabled during this time to prevent concurrent switches.",
          "category": "interaction",
          "severity": "info",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Switching..."
            },
            "label": "Switching state indicator"
          },
          "assertionType": "behavior",
          "precondition": "User has just clicked Switch on a non-active account",
          "source": "ai-generated",
          "reviewed": false,
          "enabled": true
        }
      ],
      "source": "ai-generated"
    },
