{
  "version": "1.0.0",
  "description": "Sidebar navigation — persistent navigation menu with links to all major pages. Always visible (collapsed or expanded) alongside the active page content.",
  "groups": [
    {
      "id": "sidebar-presence",
      "name": "Sidebar Presence",
      "description": "The sidebar navigation is always visible",
      "category": "element-presence",
      "assertions": [
        {
          "id": "sidebar-nav-exists",
          "description": "The main navigation landmark is present",
          "category": "element-presence",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": { "role": "navigation", "accessibleName": "Main navigation" },
            "label": "Sidebar navigation"
          },
          "enabled": true
        }
      ]
    }
  ],
  "metadata": {
    "component": "Sidebar",
    "pageUrl": "*",
    "tags": ["runner", "navigation", "sidebar", "global"]
  },
  "stateMachine": {
    "states": [
      {
        "id": "sidebar",
        "name": "Sidebar Navigation",
        "description": "The persistent sidebar with navigation items. Always active when the app is loaded.",
        "elements": [{ "role": "navigation", "accessibleName": "Main navigation" }],
        "isInitial": true,
        "transitions": [
          {
            "id": "sidebar-to-workflows",
            "name": "Navigate to Workflows",
            "activateStates": ["tab-gui-automation"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": [
              {
                "action": "click",
                "target": { "dataAttributes": { "nav-item": "workflows" } },
                "waitAfter": { "type": "idle", "timeout": 5000 }
              }
            ]
          },
          {
            "id": "sidebar-to-active",
            "name": "Navigate to Active Dashboard",
            "activateStates": ["tab-active"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": [
              {
                "action": "click",
                "target": { "dataAttributes": { "nav-item": "active" } },
                "waitAfter": { "type": "idle", "timeout": 5000 }
              }
            ]
          },
          {
