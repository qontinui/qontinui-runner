      {
        "id": "sidebar",
        "name": "Sidebar Navigation",
        "description": "The persistent sidebar with navigation items. Always active when the app is loaded.",
        "elements": [
          {
            "role": "navigation",
            "accessibleName": "Main navigation"
          }
        ],
        "isInitial": true,
        "transitions": [
          {
            "id": "sidebar-to-workflows",
            "name": "Navigate to Workflows",
            "activateStates": [
              "tab-gui-automation"
            ],
            "deactivateStates": [
              "tab-active",
              "tab-terminal",
              "tab-runs",
              "tab-error-monitor",
              "tab-processes",
              "tab-library",
              "tab-state-machine",
              "tab-settings",
              "tab-reflection"
            ],
            "staysVisible": true,
            "process": [
              {
                "action": "click",
                "target": {
                  "dataAttributes": {
                    "nav-item": "workflows"
                  }
                },
                "waitAfter": {
                  "type": "idle",
                  "timeout": 5000
                }
              }
            ]
          },
          {
            "id": "sidebar-to-active",
            "name": "Navigate to Active Dashboard",
