{
  "version": "1.0.0",
  "description": "Unified Search — searches across all knowledge graph data stores (findings, fixes, knowledge, errors, rules, workflows) and presents ranked results. Available as a dedicated tab and as a global Cmd+K command palette overlay.",
  "groups": [
    {
      "id": "unified-search-input",
      "name": "Search Input",
      "description": "Users need a search input that accepts queries of 2+ characters and returns cross-entity results ranked by relevance.",
      "category": "semantic",
      "assertions": [
        {
          "id": "uni-search-input-field",
          "description": "Users can enter search queries into a text input with a descriptive placeholder that communicates the cross-entity search capability",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Search findings, fixes, rules, errors..."
            },
            "label": "Search input with placeholder text"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-button",
          "description": "Users can submit their search query via a clearly labeled Search button",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Search"
            },
            "label": "Search submit button"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-form",
          "description": "Users can submit the search by pressing Enter in the input field, providing a keyboard-friendly form submission path",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "form"
            },
            "label": "Search form element"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "unified-search-results",
      "name": "Search Results Display",
      "description": "Users need search results showing entity type, title, snippet, and relevance score, with color-coded icons distinguishing findings (red), fixes (green), knowledge (blue), errors (orange), rules (purple), and workflows (cyan).",
      "category": "semantic",
      "assertions": [
        {
          "id": "uni-search-result-count",
          "description": "Users can see a header displaying the total number of results found, providing context for the search scope",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "result"
            },
            "label": "Result count header"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-entity-badges",
          "description": "Each result displays a color-coded entity type badge (finding, fix, knowledge, error, rule, workflow) so users can quickly identify the kind of data each result represents",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "listitem"
            },
            "label": "Search result items with entity type badges"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-relevance",
          "description": "Each result displays a relevance score percentage so users can assess how closely each result matches their query",
          "category": "semantic",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "%"
            },
            "label": "Relevance score percentage"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "unified-search-states",
      "name": "Search Feedback States",
      "description": "Clear feedback during search states.",
      "category": "semantic",
      "assertions": [
        {
          "id": "uni-search-searching",
          "description": "Users see a searching indicator while results are being fetched, providing feedback that their query is being processed",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Searching..."
            },
            "label": "Searching state message"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-failed",
          "description": "Users see an error message when search fails, helping them understand a technical issue occurred",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Search failed"
            },
            "label": "Search error state message"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "uni-search-no-results",
          "description": "Users see a no-results message when their query does not match any entities, confirming the search executed but found nothing",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "No results found"
            },
            "label": "No results state message"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "command-palette",
      "name": "Command Palette Modal",
      "description": "A global command palette accessible via Cmd+K/Ctrl+K from any page, providing the same search functionality in a modal overlay that can be dismissed with Escape.",
      "category": "architecture",
      "assertions": [
        {
          "id": "cmd-palette-modal",
          "description": "The command palette opens as a modal overlay positioned above all page content, providing a focused search experience without navigating away",
          "category": "architecture",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "dialog"
            },
            "label": "Command palette modal overlay"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "cmd-palette-esc-hint",
          "description": "The command palette displays an ESC keyboard hint so users know how to dismiss the overlay",
          "category": "architecture",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "ESC"
            },
            "label": "ESC keyboard dismiss hint"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "cmd-palette-autofocus",
          "description": "When the command palette opens, the search input is automatically focused so users can begin typing immediately",
          "category": "architecture",
          "severity": "critical",
          "assertionType": "state",
          "target": {
            "type": "search",
            "criteria": {
              "role": "textbox"
            },
            "label": "Auto-focused search input in command palette"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "cmd-palette-backdrop",
          "description": "Clicking the backdrop area outside the command palette closes it, following standard modal interaction patterns",
          "category": "architecture",
          "severity": "critical",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "dialog"
            },
            "label": "Backdrop click to close behavior"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "command-palette-results",
      "name": "Command Palette Inline Results",
      "description": "Command palette shows inline results with entity icons and click-to-navigate behavior.",
      "category": "semantic",
      "assertions": [
        {
          "id": "cmd-palette-min-chars",
          "description": "Before the user types enough characters, a hint message guides them to type at least 2 characters to trigger a search",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "Type at least 2 characters to search"
            },
            "label": "Minimum character hint message"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "cmd-palette-no-results",
          "description": "When no results match the query in the command palette, a clear message communicates this to the user",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "textContent": "No results"
            },
            "label": "Command palette no results message"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "cmd-palette-result-buttons",
          "description": "Each command palette result is a clickable button that navigates to the relevant entity view when selected",
          "category": "semantic",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": {
              "role": "button"
            },
            "label": "Clickable result buttons in command palette"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "unified-search-interaction",
      "name": "Search Interaction",
      "description": "Users interact with the search via text input, form submission, and in the command palette via keyboard shortcuts. The search requires minimum 2 characters and the submit button is disabled until met.",
      "category": "interaction",
      "assertions": [
        {
          "id": "search-interaction-min-chars",
          "description": "The Search button is disabled when the query is less than 2 characters, preventing empty or single-character searches",
          "category": "interaction",
          "severity": "critical",
          "assertionType": "disabled",
          "target": {
            "type": "search",
            "criteria": { "textContent": "Search" },
            "label": "Disabled search button"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-form-submit",
          "description": "Pressing Enter in the search input submits the form when the query has 2+ characters",
          "category": "interaction",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": { "role": "textbox" },
            "label": "Search input form submission"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-cmd-k-toggle",
          "description": "Pressing Cmd+K (Mac) or Ctrl+K (Windows/Linux) toggles the command palette modal overlay open and closed",
          "category": "interaction",
          "severity": "critical",
          "assertionType": "behavior",
          "precondition": "Tauri webview has keyboard focus",
          "target": {
            "type": "search",
            "criteria": { "textContent": "ESC" },
            "label": "Command palette keyboard shortcut"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-escape-close",
          "description": "Pressing Escape closes the command palette and clears the search query",
          "category": "interaction",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": { "textContent": "ESC" },
            "label": "Escape to close palette"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-backdrop-close",
          "description": "Clicking the backdrop (area outside the modal) closes the command palette",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "behavior",
          "precondition": "Command palette is open",
          "target": {
            "type": "search",
            "criteria": { "textContent": "ESC" },
            "label": "Backdrop click to close"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-autofocus",
          "description": "When the command palette opens, the search input receives focus automatically so the user can start typing immediately",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "behavior",
          "precondition": "Command palette just opened",
          "target": {
            "type": "search",
            "criteria": { "role": "textbox" },
            "label": "Auto-focused search input"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-interaction-result-click",
          "description": "Clicking a search result in the command palette closes the modal (navigation to the result's entity is a future enhancement)",
          "category": "interaction",
          "severity": "warning",
          "assertionType": "behavior",
          "precondition": "Search has returned results",
          "target": {
            "type": "search",
            "criteria": { "role": "button" },
            "label": "Clickable result rows"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "unified-search-data-display",
      "name": "Search Result Rendering",
      "description": "Search results display entity type icons with color coding, titles, snippet previews (2-line clamp), relevance scores as percentages, and a summary header with counts per entity type.",
      "category": "data-display",
      "assertions": [
        {
          "id": "search-data-result-count",
          "description": "The results header shows the total count (e.g. '12 results') with per-type breakdown badges",
          "category": "data-display",
          "severity": "warning",
          "assertionType": "containsText",
          "expected": "Format '{N} result' or '{N} results' with per-entity-type badges",
          "target": {
            "type": "search",
            "criteria": { "textContent": "result" },
            "label": "Result count header"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-data-relevance-score",
          "description": "Each result shows a relevance score as a percentage (e.g. '87%') in monospace font, aligned to the right",
          "category": "data-display",
          "severity": "info",
          "assertionType": "exists",
          "expected": "Percentage 0-100, computed as Math.round(relevance_score * 100)",
          "target": {
            "type": "search",
            "criteria": { "textContent": "%" },
            "label": "Relevance score percentage"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-data-entity-type-badge",
          "description": "Each result has a capitalized entity type badge (finding, fix, knowledge, error, rule, workflow) distinguishing the result's source",
          "category": "data-display",
          "severity": "warning",
          "assertionType": "exists",
          "expected": "One of: finding, fix, knowledge, error, rule, workflow — capitalized",
          "target": {
            "type": "search",
            "criteria": { "textContent": "finding|fix|knowledge|error|rule|workflow" },
            "label": "Entity type badge"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    },
    {
      "id": "unified-search-navigation",
      "name": "Search Navigation",
      "description": "The unified search is accessible both as a dedicated tab (/unified-search) and as a global command palette (Cmd+K) from any page in the application.",
      "category": "navigation",
      "assertions": [
        {
          "id": "search-nav-tab-access",
          "description": "The unified search is available as a dedicated tab page accessible via the tab navigation system",
          "category": "navigation",
          "severity": "warning",
          "assertionType": "exists",
          "target": {
            "type": "search",
            "criteria": { "textContent": "Search Everything" },
            "label": "Unified search tab page"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        },
        {
          "id": "search-nav-global-palette",
          "description": "The command palette is rendered globally in App.tsx and available from any page via Cmd+K/Ctrl+K without navigating away",
          "category": "navigation",
          "severity": "critical",
          "assertionType": "behavior",
          "target": {
            "type": "search",
            "criteria": { "textContent": "ESC" },
            "label": "Global command palette"
          },
          "source": "manual",
          "reviewed": true,
          "enabled": true
        }
      ],
      "source": "manual"
    }
  ],
  "stateMachine": {
    "states": [
      {
        "id": "search-idle",
        "name": "Search Idle",
        "description": "The unified search page is loaded with an empty input field and no results displayed. The search button is disabled because the minimum 2-character threshold has not been met.",
        "elements": [
          { "role": "form" },
          { "textContent": "Search findings, fixes, rules, errors..." }
        ],
        "isInitial": true,
        "transitions": [
          {
            "id": "idle-to-searching",
            "name": "Submit search query",
            "description": "User types 2+ characters and submits the form via Enter or the Search button, triggering the search",
            "activateStates": ["search-searching"],
            "deactivateStates": ["search-idle"],
            "staysVisible": false,
            "process": [
              {
                "action": "fill",
                "target": {
                  "role": "textbox",
                  "textContent": "Search findings, fixes, rules, errors..."
                },
                "value": "test query",
                "waitAfter": { "type": "idle", "timeout": 500 }
              },
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Search" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "idle-to-palette",
            "name": "Open command palette",
            "description": "User presses Cmd+K or Ctrl+K to open the global command palette overlay",
            "activateStates": ["palette-open"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": [
              {
                "action": "keyboard",
                "target": { "key": "k", "modifiers": ["Control"] },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "search-searching",
        "name": "Search In Progress",
        "description": "A search query has been submitted and results are being fetched. The 'Searching...' indicator is visible to provide user feedback.",
        "elements": [{ "textContent": "Searching..." }],
        "transitions": [
          {
            "id": "searching-to-results",
            "name": "Results returned",
            "description": "The search completes successfully with matching results, displaying the results list with entity badges and relevance scores",
            "activateStates": ["search-results"],
            "deactivateStates": ["search-searching"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "searching-to-no-results",
            "name": "No results returned",
            "description": "The search completes successfully but no entities matched the query",
            "activateStates": ["search-no-results"],
            "deactivateStates": ["search-searching"],
            "staysVisible": false,
            "process": []
          },
          {
            "id": "searching-to-failed",
            "name": "Search failed",
            "description": "The search request encountered an error during processing",
            "activateStates": ["search-failed"],
            "deactivateStates": ["search-searching"],
            "staysVisible": false,
            "process": []
          }
        ]
      },
      {
        "id": "search-results",
        "name": "Results Displayed",
        "description": "Search results are displayed with a count header, entity type badges (finding, fix, knowledge, error, rule, workflow), titles, snippets, and relevance score percentages.",
        "elements": [{ "textContent": "result" }, { "role": "listitem" }, { "textContent": "%" }],
        "transitions": [
          {
            "id": "results-to-searching",
            "name": "Submit new search query",
            "description": "User modifies the query and resubmits, starting a new search",
            "activateStates": ["search-searching"],
            "deactivateStates": ["search-results"],
            "staysVisible": false,
            "process": [
              {
                "action": "fill",
                "target": { "role": "textbox" },
                "value": "new query",
                "waitAfter": { "type": "idle", "timeout": 500 }
              },
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Search" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "results-to-palette",
            "name": "Open command palette from results",
            "description": "User presses Cmd+K or Ctrl+K to open the command palette while results are displayed",
            "activateStates": ["palette-open"],
            "deactivateStates": [],
            "staysVisible": true,
            "process": [
              {
                "action": "keyboard",
                "target": { "key": "k", "modifiers": ["Control"] },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "search-no-results",
        "name": "No Results Found",
        "description": "The search completed but returned no matching entities. A 'No results found' message is displayed to the user.",
        "elements": [{ "textContent": "No results found" }],
        "transitions": [
          {
            "id": "no-results-to-searching",
            "name": "Submit new search query",
            "description": "User modifies the query and resubmits to try a different search",
            "activateStates": ["search-searching"],
            "deactivateStates": ["search-no-results"],
            "staysVisible": false,
            "process": [
              {
                "action": "fill",
                "target": { "role": "textbox" },
                "value": "different query",
                "waitAfter": { "type": "idle", "timeout": 500 }
              },
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Search" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          }
        ]
      },
      {
        "id": "search-failed",
        "name": "Search Failed",
        "description": "The search encountered an error. A 'Search failed' message is displayed to communicate the technical issue to the user.",
        "elements": [{ "textContent": "Search failed" }],
        "transitions": [
          {
            "id": "failed-to-searching",
            "name": "Retry search",
            "description": "User resubmits the query to retry after a failure",
            "activateStates": ["search-searching"],
            "deactivateStates": ["search-failed"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "button", "textContent": "Search" },
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          }
        ]
      },
      {
        "id": "palette-open",
        "name": "Command Palette Open",
        "description": "The command palette modal overlay is open with an auto-focused search input and an ESC hint. Before the user types 2+ characters, a minimum character hint is shown.",
        "elements": [
          { "role": "dialog" },
          { "textContent": "ESC" },
          { "textContent": "Type at least 2 characters to search" }
        ],
        "transitions": [
          {
            "id": "palette-to-palette-results",
            "name": "Type search query in palette",
            "description": "User types 2+ characters in the palette input, triggering inline results",
            "activateStates": ["palette-results"],
            "deactivateStates": ["palette-open"],
            "staysVisible": false,
            "process": [
              {
                "action": "fill",
                "target": { "role": "textbox" },
                "value": "test",
                "waitAfter": { "type": "idle", "timeout": 2000 }
              }
            ]
          },
          {
            "id": "palette-to-closed-esc",
            "name": "Close palette with Escape",
            "description": "User presses Escape to close the command palette and clear the query",
            "activateStates": ["search-idle"],
            "deactivateStates": ["palette-open"],
            "staysVisible": false,
            "process": [
              {
                "action": "keyboard",
                "target": { "key": "Escape" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          },
          {
            "id": "palette-to-closed-backdrop",
            "name": "Close palette with backdrop click",
            "description": "User clicks outside the modal to close the command palette",
            "activateStates": ["search-idle"],
            "deactivateStates": ["palette-open"],
            "staysVisible": false,
            "process": [
              {
                "action": "click",
                "target": { "role": "dialog" },
                "waitAfter": { "type": "idle", "timeout": 1000 }
              }
            ]
          }
        ]
      },
      {
        "id": "palette-results",
        "name": "Command Palette With Results",
